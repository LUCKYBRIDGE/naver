{
  "manifest_version": 3,
  "name": "웨일스페이스 웨일 듀얼 인풋",
  "version": "1.0.0",
  "description": "웨일 듀얼 인풋 - 웨일스페이스 교육용 확장 프로그램",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "sidebar_action": {
    "default_page": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "웨일 듀얼 인풋"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}