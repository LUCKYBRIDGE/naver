{
  "manifest_version": 3,
  "name": "웨일스페이스 웨일 듀얼 인풋",
  "version": "0.2.0",
  "description": "웨일 듀얼 인풋 - 웨일스페이스 교육용 확장 프로그램",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "sidebar_action": {
    "default_page": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "웨일 듀얼 인풋"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "nativeMessaging"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
