<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>WhaleDualInput.Isolation.A</AssemblyName>
    <ApplicationManifest>research-uiaccess.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../WhaleDualInput.Probe/*.cs" Link="Research/%(Filename)%(Extension)" />
    <Compile Include="../WhaleDualInput.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
